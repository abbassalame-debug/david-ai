# Copy to .env (git-ignored) and fill in only what you use. Everything is optional: David runs fully local with none of these set.
# david_config.py reads this file at start-up (python-dotenv); real environment variables win over the file.

# ── Where things live (defaults in parentheses) ──────────────────────────────
# DAVID_HOME=               # the repository folder (this folder)
# DAVID_DATA=               # runtime state: index, SQLite files, logs, generated files (<DAVID_HOME>/data)
# DAVID_VAULTS=             # one sub-folder per note vault (<DAVID_HOME>/vaults)
# OLLAMA_HOST=http://127.0.0.1:11434
# DAVID_EMBEDDER=qwen3-embedding-0.6b      # or bge-m3 (needs requirements-ml.txt)
# DAVID_GENERAL_MODEL=qwen3.5:9b           # the model for the 'general' domain (set a different model to run a second, fine-tuned one)
# DAVID_FAILOVER_MODEL=qwen3.5:9b          # the model retried when the routed local model is missing or fails
# DAVID_AUDIO_PYTHON=       # a Python that has demucs/torch, for stem separation (default: this interpreter)
# DAVID_COMFYUI_DIR=        # a ComfyUI install, for the generate.* design operations (<DAVID_HOME>/ComfyUI)
# DAVID_COMFY_BUDGET_S=180  # how long to wait for ComfyUI to start
# DAVID_TRANSCRIPTS=        # chat transcript retention: days to keep (default 90), "keep" for ever, or "off" (see SECURITY.md)

# ── Cloud tiers (optional; off unless a key is set) ──────────────────────────
# Tier 2 / Tier 3 escalation is gated by the DLP patterns, the per-agent firewall and a monthly budget (david_router.py).
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# ── Restaurant vertical ──────────────────────────────────────────────────────
# DAVID_RESTAURANT_ROOT=    # folder holding <MM-YYYY>/<DD-MM-YYYY>/ day folders (examples/demo_bistro)
# The upload step writes to YOUR database inside one transaction, only when you press the button. Read in exactly one place (restaurant_upload.py).
# DAVID_APP_DB_URL=postgresql://user:password@host:5432/dbname

# ── Obsidian bridge (obsidian_mcp.js) ────────────────────────────────────────
# OBSIDIAN_MCP_ALLOW_RESEARCH=1    # opt the firewalled Research vault into the MCP bridge
